# Configurações do Backend - Sirius App
# Copie este arquivo para .env e preencha os valores

# MongoDB Atlas (obrigatório)
MONGO_URL=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/<banco>?retryWrites=true&w=majority
DB_NAME=sirius_production

# Google Gemini API (opcional - pode usar chave do usuário)
GOOGLE_GEMINI_API_KEY=

# Telegram Bot (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_WEBHOOK_SECRET=

# JWT Secret (gere uma chave aleatória)
JWT_SECRET=sua_chave_secreta_aqui_mude_em_producao

# Frontend URL (para CORS)
FRONTEND_URL=https://seufrontend.onrender.com

# Environment
ENVIRONMENT=production

# Sirius Agent — leave paid models and automatic writes disabled.
AI_AGENT_ENABLED=true
AI_RAG_ENABLED=true
AI_VOICE_ENABLED=true
AI_AUTOMATIONS_ENABLED=true
AI_AUTO_ACTIONS_ENABLED=false
AI_STREAMING_ENABLED=false
AI_PAID_MODELS_ENABLED=false
AUTOMATION_DRY_RUN=true
RUN_AI_LIVE_TESTS=false
AI_INTERNAL_DAILY_LIMIT=200
# Generate privately with cryptography.fernet.Fernet.generate_key(); never commit a real value.
AI_KEY_ENCRYPTION_KEY=
# Optional existing Atlas vectorSearch index (768 dimensions, owned filters).
AI_ATLAS_VECTOR_INDEX=
